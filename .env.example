LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional local JSON voice profile. No credentials belong in the profile.
VOICE_PROFILE=examples/voice-profile.json
# Blank means no transcript persistence. Never use real calls in the portfolio demo.
VOICE_TRANSCRIPT_DIR=
VOICE_TRANSCRIPT_CONSENT=false

# Optional synthetic clinic reception mode. Use a writable local SQLite path.
# CLINIC_DEMO_DB=clinic-demo.sqlite3
